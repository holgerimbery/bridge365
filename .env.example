# Backend Service Configuration - Copy to .env and fill in your values
# This file is for local script execution; production uses Azure App Service settings

# Azure subscription and resource group
# AZURE_SUBSCRIPTION_ID is optional but recommended: it is used to run
# `az account set --subscription` before any deployment/config command, so
# scripts always target the correct subscription/tenant instead of whatever
# happens to be active in your local `az login` session.
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESOURCE_GROUP=my-resource-group
LOCATION=eastus

# App Service configuration
APP_SERVICE_NAME=shared-mailbox-classifier

# Microsoft Entra ID / Azure AD credentials
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=your-client-secret-here
SECURITY_GROUP_NAME=AppAccess-SharedMailbox

# Authorization - allowlist of caller email addresses. Authentication is
# handled entirely by Azure App Service Authentication (Easy Auth) with
# Microsoft Entra ID (see enable-backend-auth.ps1); this only decides which
# signed-in identities may call the API.
ALLOWED_EMAIL_ADDRESSES=user1@company.com,user2@company.com

# Testing configuration
BACKEND_URL=https://shared-mailbox-classifier.azurewebsites.net
MAILBOX_ADDRESS=test@company.com
